<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<Version>0.0.1-alpha</Version>
		<Authors>Tsinswreng</Authors>
		<Description></Description>
		<PackageTags>logging;ILogger;delegation;polymorphic;cross-platform</PackageTags>
		<RepositoryUrl>https://github.com/Tsinswreng/Tsinswreng.CsLog.git</RepositoryUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Tsinswreng.CsCore" Version="0.0.1-alpha" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
	</ItemGroup>

</Project>
